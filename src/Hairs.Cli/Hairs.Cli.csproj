<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Hairs.Cli</RootNamespace>
    <AssemblyName>Hairs.Cli</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hairs</ToolCommandName>
    <PackageId>Hairs.Cli</PackageId>
    <Authors>HAIRS contributors</Authors>
    <Description>Human AI Review System (HAIRS) CLI: code-review coverage, freshness checks, and declaration assurance.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>hairs.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\hairs.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hairs\Hairs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hairs.Tests" />
  </ItemGroup>

</Project>
